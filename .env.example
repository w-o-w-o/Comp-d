# Copy this file to .env.local and fill in your keys from
# https://dashboard.clerk.com → your app → Configure → API keys.
# .env.local is git-ignored, so your secret key never goes to GitHub.
# On Vercel, add the same two variables under Project → Settings → Environment Variables.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Google Maps (address suggestions + results map). From Google Cloud Console →
# APIs & Services → Credentials. Enable "Maps JavaScript API" and "Places API (New)",
# and restrict the key to your site addresses, since browsers can see it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here

# Optional: custom map look. Google Cloud Console → Google Maps Platform →
# Map Management → create a Map ID (JavaScript, Vector) and attach a Map Style.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
